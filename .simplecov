# frozen_string_literal: true

SimpleCov.start do
  enable_coverage :branch
  track_files 'lib/**/*.rb'
  add_filter '/spec/'
  add_filter '/benchmark/' # opt-in measurement tooling, not shipped production code
  add_filter 'rush/parser.rb' # generated by racc; excluded from coverage

  # parallel_tests gives every shard a distinct command name. SimpleCov locks and
  # merges their result sets; only the final shard waits for the others, renders
  # the combined report, and applies these thresholds. Earlier shards use the
  # no-output formatter so they do not overwrite coverage/ with partial reports.
  group = ENV.fetch('TEST_ENV_NUMBER', nil)
  groups = ENV.fetch('PARALLEL_TEST_GROUPS', nil)
  if group && group != groups
    formatter SimpleCov::Formatter::SimpleFormatter
  else
    # coverage/coverage.xml (cobertura) is what CI ships to Codecov. Not the
    # bundled JSON formatter: Codecov's simplecov processor matches only the
    # third-party simplecov-json layout, so the official JSON parses to
    # nothing there (state: error, observed on run 29473353200).
    require 'simplecov-cobertura'
    formatter SimpleCov::Formatter::MultiFormatter.new(
      [SimpleCov::Formatter::HTMLFormatter, SimpleCov::Formatter::CoberturaFormatter]
    )
  end

  # Guardrail, not dogma: rush aims for 100% meaningful coverage, but shell
  # behaviour crosses fork/exec boundaries that SimpleCov cannot observe.
  minimum_coverage line: 95, branch: 90
end
