# Minimal stdlib Fiddle surface used by SystemCalls::Collation. The bridge keeps
# native signatures as untyped values; rush's own public boundary remains typed.
module Fiddle
  TYPE_VOIDP: Integer
  TYPE_INT: Integer
  TYPE_SIZE_T: Integer
  TYPE_VOID: Integer
  RUBY_FREE: Integer

  class DLError < StandardError
  end

  class Handle
    DEFAULT: Handle

    def []: (String symbol) -> Integer
  end

  class Function
    def initialize: (Integer address, untyped arguments, untyped result) -> void
    def call: (*untyped arguments) -> untyped
  end

  class Pointer
    def self.malloc: (Integer size, Integer freefunc) -> Pointer
    def null?: () -> bool
  end
end
