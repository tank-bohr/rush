module Rush
  # Normal vs silent getopts error-mode formatting for bad options and missing
  # arguments.
  class GetoptsErrorMode
    extend T::Sig

    @missing_name: String

    @keep_optarg: bool

    @diagnostic: bool

    def initialize: (Symbol mode) -> void

    def missing_name: () -> String

    def optarg: (String value) -> String?

    def message: (String text) -> String?

  end

  # The getopts optstring operand (POSIX `getopts optstring name [arg...]`):
  # a leading colon selects silent error reporting, then each option letter,
  # `:`-suffixed when it requires an argument. Owns which letters are legal
  # and which take arguments; the parser keeps the cursor choreography.
  class Optstring
    extend T::Sig

    @letters: String

    attr_reader error_mode: GetoptsErrorMode

    def initialize: (String text) -> void

    def valid?: (String option) -> bool

    def requires_argument?: (String option) -> bool

    private

    def index: (String option) -> Integer?
  end

  # Pure parser for one POSIX getopts step. It walks the argv words and the
  # hidden cluster cursor against the Optstring's semantics; the builtin
  # applies the returned variable updates.
  class GetoptsParser
    extend T::Sig

    class Result < ::Data
      attr_reader name: String
      attr_reader optarg: String?
      attr_reader optind: Integer
      attr_reader message: String?
      attr_reader exitstatus: Integer
      attr_reader keep_optarg: bool

      def self.new: (name: String, optarg: String?, optind: Integer, message: String?, exitstatus: Integer, keep_optarg: bool) -> Result
    end

    class Option < ::Data
      attr_reader argument: String
      attr_reader name: String

      def self.new: (argument: String, name: String) -> Option
    end

    @state: GetoptsState

    @optstring: Optstring

    @error_mode: GetoptsErrorMode

    @arguments: Array[String]

    def initialize: (state: GetoptsState, optstring: String, arguments: Array[String], optind: Integer) -> void

    def call: () -> Result

    private

    def dispatch: (Option option) -> Result

    def found: (String name, String value) -> Result

    def invalid: (Option option) -> Result

    def missing: (Option option) -> Result

    def finish: () -> Result

    def finish_double_dash: () -> Result

    def consume_found: (String value) -> void

    def consume_missing: (String _argument) -> void

    def argument_value: (Option option) -> Result

    def error_result: (String name, String silent_optarg, String normal_message) -> Result

    def result: (String name, String? optarg, String? message, Integer status) -> Result

    def kept_result: () -> Result

    def option: (String argument) -> Option

    def attached_argument: (String argument) -> String

    def attached_value?: (String argument, String value) -> bool

    def attached?: (String argument) -> bool

    def next_argument: () -> String?
  end
end
