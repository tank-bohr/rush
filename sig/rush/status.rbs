module Rush
  # Immutable result of running a command. $? can hold a value wider than a byte:
  # dash keeps `return 300` as 300 in-process, and only wraps to 0-255 at a real
  # process boundary (exit!/the shell's own exit, where the OS truncates). The
  # operand is validated non-negative and <= INT_MAX before reaching here.
  class Status
    extend T::Sig

    attr_reader exitstatus: Integer

    attr_reader stopsig: Integer?

    attr_reader termsig: Integer?

    @coredump: bool?

    def initialize: (Integer exitstatus, ?stopsig: Integer?, ?termsig: Integer?, ?coredump: bool?) -> void

    # The OS recorded a core dump alongside the killing signal (WCOREDUMP,
    # nil when no dump information accompanied the status): SignalReport
    # suffixes its message with " (core dumped)" like dash.
    def coredump?: () -> bool

    def success?: () -> bool

    # The job this status describes is stopped, not gone (rush-mv8.4).
    def stopped?: () -> bool

    # The same verdict carrying a sibling stage's stop signal.
    def with_stop: (Integer? stopsig) -> Status

    def self.success: () -> instance

    def self.failure: (?Integer code) -> instance

    # A signalled process reports no exitstatus; POSIX maps it to 128 + signal.
    def self.of: (::Process::Status process_status) -> instance

    def self.stopped: (Integer stopsig) -> instance
  end
end
