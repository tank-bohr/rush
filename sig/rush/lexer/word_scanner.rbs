module Rush
  class Lexer
    # Scans one word from the shared StringScanner into an AST::Word of typed
    # segments: literal runs (quote-removed, with a `quoted` flag) and :param
    # segments for $name / ${...}. Handles the three quoting forms; command
    # substitution and arithmetic arrive in later slices.
    class WordScanner
      extend T::Sig
      include ScannerPredicates

      @scanner: StringScanner

      @terminator: Regexp?

      @buffer: SegmentBuffer

      TERMINATOR: Regexp

      DISPATCH: Hash[String, Symbol]

      def self.next_word: (StringScanner scanner, interactive: bool) -> AST::Word

      def self.entire: (String text) -> AST::Word

      @interactive: bool

      def initialize: (StringScanner scanner, terminator: Regexp?, interactive: bool) -> void

      def scan: () -> AST::Word

      private

      def terminates?: (String char) -> bool

      def rewind_then_build: () -> AST::Word

      def step: (String char) -> void

      def single_quote: () -> void

      def double_quote: () -> void

      def dollar: () -> void

      def backtick: () -> void

      def escape: () -> void

      # A backslash that ends the input stays literal, like dash.
      def trailing_backslash: () -> void

      # Line continuation (POSIX 2.2.1): the backslash-newline pair vanishes.
      def continuation: () -> void

      def push: (untyped value, quoted: bool) -> void
    end
  end
end
