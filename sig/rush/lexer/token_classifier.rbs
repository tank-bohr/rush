module Rush
  class Lexer
    # Classifies a scanned word given the lexer state: a reserved word (only an
    # unquoted single-literal word in command position), an ASSIGNMENT_WORD (an
    # unquoted NAME= prefix), or a plain WORD. The assignment value keeps its
    # quoted segments (x="a b").
    class TokenClassifier
      extend T::Sig

      class AssignmentHead
        extend T::Sig

        attr_reader name: String
        attr_reader literal: String

        @source_line: Integer

        def initialize: (String name, String literal, Integer source_line) -> void

        def assignment: (Array[AST::WordSegment[untyped]] tail) -> AST::Assignment

        private

        def word: (Array[AST::WordSegment[untyped]] tail) -> AST::Word
      end

      @word: AST::Word

      @state: LexState

      NAME: Regexp

      RESERVED: Hash[String, Symbol]

      FOR_IN: Hash[String, Symbol]

      def initialize: (AST::Word word, LexState state) -> void

      def call: () -> [ Symbol, untyped ]

      private

      def state_token: () -> [ Symbol, untyped ]?

      def forced: () -> [ Symbol, untyped ]?

      def header_token: () -> [ Symbol, untyped ]?

      def arm_token: () -> Symbol

      def classify: () -> [ Symbol, untyped ]

      def for_header: () -> Symbol?

      def reserved: () -> Symbol?

      def lookup: (Hash[String, Symbol] table) -> Symbol?

      def assignment_head: () -> AssignmentHead?

      def assignment_literal: () -> String?

      def capture: (String value) -> String?

      def assignment_token: (AssignmentHead head) -> [ Symbol, untyped ]
    end
  end
end
