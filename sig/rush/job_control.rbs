module Rush
  # The monitor-mode (`set -m`) policy: whether job control is active here,
  # and the side effects of flipping the flag (base signal dispositions, the
  # terminal-acquisition dance, the double-setpgid fork, foreground terminal
  # handover). Stateless — Executor builds one on demand; the durable bits
  # (root shell, acquired terminal) live on the JobTable.
  class JobControl
    extend T::Sig

    IGNORE: Proc

    @executor: Executor

    def initialize: (Executor executor) -> void

    # `set -m`: side effects + flag together; warns and leaves the flag off
    # when refused (platform gate, or interactive without a tty).
    def enable: (_IoStream stderr) -> void

    # `set +m`: the flag drops, the base dispositions return to the OS
    # default, and the terminal goes back to its owner at acquisition.
    def disable: () -> void

    # Invocation-time -m (explicit or interactive-defaulted): re-run the
    # flag through #enable once the executor exists.
    def startup: () -> void

    # Process grouping is active: monitor on and this is the root shell.
    def monitored?: () -> bool

    # Fork one member of a foreground job, into `leader`'s process group
    # (its own when none) under job control; a group leader takes the
    # terminal when the shell holds one.
    def launch: (?leader: Integer?) { () -> void } -> Integer

    # An asynchronous (&) job: its own group, never the terminal.
    def launch_background: () { () -> void } -> Integer

    # Wait for a foreground job with the terminal handed to its process
    # group, reclaiming it afterwards (dash waitforjob); a stopped wait
    # parks the whole job in the table.
    def foreground: (Array[Integer] pids) { () -> Status } -> Status

    private

    def holding_terminal: (Integer leader) { () -> Status } -> Status

    def enable_root: (_IoStream stderr) -> void

    def enable_with_terminal: (Terminal terminal) -> void

    def enable_off_tty: (_IoStream stderr) -> void

    def drop_monitor: () -> void


    def handover_tty: (Integer group) -> untyped

    def refuse: (_IoStream stderr, String message) -> void

    def control: () -> JobTable::Control

    def system: () -> SystemCalls

    def interactive?: () -> bool

    def options: () -> Options
  end
end
