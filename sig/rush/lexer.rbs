module Rush
  # StringScanner pump that yields [symbol, value] pairs for racc. It skips
  # blanks and comments, then emits NEWLINE, an IO_NUMBER, an operator, or a
  # WORD/ASSIGNMENT_WORD (classified against LexState, which advances after each
  # token to track command position — the seed of POSIX Grammar Rules 1-9).
  class Lexer
    extend T::Sig
    include TokenPredicates

    # A terminal as the grammar names it: a Symbol tag, or the literal
    # single-character operators ('<', ';', '(' …) the grammar spells as-is.
    type token_kind = Symbol | String

    # What a rule action receives as val[i]: an AST Word/Assignment, the
    # HereDoc holder standing in for a WORD, an operator/newline string, or
    # an IO_NUMBER's integer.
    type token_value = AST::Word | AST::Assignment | HereDoc | String | Integer

    # One [kind, value] pair handed to racc ([false, false] marks the end of
    # input and is spelled separately where it can occur).
    type token = [token_kind, token_value]

    TokenKind: untyped
    TokenValue: untyped
    Token: untyped
    NextToken: untyped

    @scanner: StringScanner

    @aliases: AliasExpander

    @interactive: bool

    @state: LexState

    @lines: SourceLines

    @awaiting: Symbol?

    @heredocs: Array[HereDoc]

    # Between tokens, blanks, comments and backslash-newline continuations
    # (POSIX 2.2.1) are all insignificant. A continuation at the buffer's very
    # end is left for the word scanner, which asks for the next line instead
    # of ending the token stream.
    INSIGNIFICANT: Regexp

    IO_NUMBER: Regexp

    # keys are :DLESS/:DLESSDASH, but operator tags are looked up here as Symbol|String
    # (some operators are literal strings), and a non-heredoc op just misses.
    HEREDOC_OPS: Hash[Symbol | String, Symbol]

    def initialize: (String source, ?interactive: bool, ?aliases: AliasTable?, ?line_offset: Integer) -> void

    def location: () -> Integer

    def next_token: () -> (token | [ false, false ])

    private

    def emit: (token token) -> token

    # Skip blanks and comments; when the current frame is an exhausted alias
    # replacement, restore the input beneath it and keep skipping.
    def drain: () -> void

    def skip_insignificant: () -> void

    def scan_token: () -> token?

    def io_number: () -> token?

    def operator: () -> token?

    def operator_token: (String matched) -> token

    # Classify the word, then (only a plain WORD, never a reserved word or a
    # here-document delimiter) splice its alias replacement in its place; a splice
    # returns nil so next_token re-reads from the new frame.
    def word: () -> token?

    def alias_for: (token token, AST::Word word) -> AliasExpander::Replacement?

    def splice: (AliasExpander::Replacement replacement) -> nil

    def delimiter: (AST::Word word) -> token

    # On the newline that ends the command line, drain the pending here-docs:
    # read each body from the lines that follow, in the order the `<<`s appeared.
    def heredoc_newline: () -> token
  end
end
