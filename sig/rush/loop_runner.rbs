module Rush
  # Runs a while/until loop, catching break/continue at the loop boundary (see
  # LoopControlHandling). The loop's status is the last body status (0 if the
  # body never runs).
  class LoopRunner
    extend T::Sig

    @executor: Executor

    @condition: AST::Node

    @body: AST::Node

    @sense: :while | :until

    include LoopControlHandling

    def initialize: (Executor executor, AST::Node condition, AST::Node body, :while | :until sense) -> void

    # Bracket the loop so break/continue see the right nesting depth; leave runs
    # even when break unwinds.
    def call: () -> Status

    private

    def run_loop: () -> Status

    def proceed?: () -> bool

    def iterate: () -> Status
  end
end
