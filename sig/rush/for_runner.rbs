module Rush
  # Runs a for loop: assign the variable to each value in turn and run the body,
  # catching break/continue at the loop boundary (see LoopControlHandling). The
  # loop's status is the last body status (0 if the value list is empty).
  class ForRunner
    extend T::Sig

    @executor: Executor

    @name: String

    @values: Array[String]

    @body: AST::Node

    include LoopControlHandling

    def initialize: (Executor executor, String name, Array[String] values, AST::Node body) -> void

    # Bracket the loop so break/continue see the right nesting depth; leave runs
    # even when break unwinds.
    def call: () -> Status

    private

    def run_loop: () -> Status

    def iterate: (String value) -> Status
  end
end
