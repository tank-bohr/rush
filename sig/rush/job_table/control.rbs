module Rush
  class JobTable
    # The job-control environment of this shell: the root-shell bit and,
    # while the root shell holds one, the acquired controlling terminal —
    # dash's rootshell guard and ttyfd/initialpgrp globals.
    class Control
      extend T::Sig

      @root: bool

      @monitor: bool

      @terminal: Terminal?

      @warning: Integer

      attr_reader root: bool

      attr_reader monitor: bool

      attr_reader terminal: Terminal?

      def initialize: () -> void

      # `set -m` accepted in the root shell (terminal nil off-tty).
      def engage: (Terminal? terminal) -> void

      def release: () -> void

      def fork_child: () -> void

      # The per-job job-control stamp for entries created now.
      def origin: () -> Symbol

      # dash's job_warning window for the stopped-jobs exit refusal.
      def warn_exit?: () -> bool

      def tick_warning: () -> void
    end
  end
end
