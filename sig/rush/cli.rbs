module Rush
  # Entry point: dispatch to the interactive REPL or the non-interactive source
  # runner and return the process exit code. Supports `-c command`, a batch
  # program on stdin, and an interactive REPL when invoked with no arguments on a
  # terminal.
  class CLI
    extend T::Sig

    @argv: Array[String]

    @system: SystemCalls

    def self.run: (Array[String] argv, ?system: SystemCalls) -> Integer

    def initialize: (Array[String] argv, SystemCalls system) -> void

    def run: () -> Integer

    private

    def repl?: () -> bool
  end
end
