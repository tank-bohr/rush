module Rush
  # The body of the racc-generated Rush::Parser (its `---- inner` block only
  # `include`s this), kept in a normal linted/covered file. Rule actions call
  # these factories; none contain node logic.
  module ParserSupport
    @lexer: Lexer

    def initialize: (Lexer lexer) -> void

    def parse: () -> untyped

    def next_token: () -> [ untyped, untyped ]

    def on_error: (untyped token_id, untyped value, untyped _stack) -> bot

    private

    # Provided by the Racc::Parser host this module is mixed into (no rbs for racc).
    def do_parse: () -> untyped

    def token_to_str: (untyped token_id) -> untyped

    def make_list: (Array[[AST::Node, String]] entries) -> AST::List

    def pending_entry: (AST::Node and_or) -> [AST::Node, String]

    def terminate_list: (untyped entries, String sep) -> untyped

    def append_and_or: (untyped entries, String sep, AST::Node and_or) -> untyped

    def make_and_or: (AST::Node left, Symbol op, AST::Node right) -> AST::AndOr

    def make_pipeline: (Array[AST::Node] commands, bool negate) -> AST::Pipeline

    def make_if: (AST::Node condition, AST::Node consequent, AST::Node? alternative) -> AST::If

    def make_brace_group: (AST::Node body) -> AST::BraceGroup

    def make_subshell: (AST::Node body) -> AST::Subshell

    def make_redirected: (AST::Node command, Array[AST::Redirect] redirects) -> AST::Redirected

    def make_while: (AST::Node condition, AST::Node body) -> AST::While

    def make_until: (AST::Node condition, AST::Node body) -> AST::Until

    def make_for: (String name, Array[AST::Word]? words, AST::Node body) -> AST::For

    def make_case: (AST::Word word, Array[AST::CaseItem] items) -> AST::Case

    def make_case_item: (Array[AST::Word] patterns, AST::Node body) -> AST::CaseItem

    def make_function: (AST::Word word, AST::Node body) -> AST::FunctionDef

    def make_simple_command: (untyped prefix, untyped word, untyped suffix) -> untyped

    def make_redirect: (Symbol kind, AST::Word target) -> AST::Redirect

    def make_heredoc: (untyped holder) -> AST::Redirect

    def with_io_number: (AST::Redirect redirect, Integer number) -> AST::Redirect
  end
end
