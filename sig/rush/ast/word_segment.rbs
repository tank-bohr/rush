module Rush
  module AST
    # A typed piece of a word. Subclasses know how to expand themselves (the
    # segment-level counterpart of a command node's #execute), so there is no
    # `kind` to dispatch on: `quoted` records whether it came from a quoted
    # context (which governs field splitting and pathname expansion), `value` is
    # the kind-specific payload (literal text, a ParamRef, or substitution
    # source). literal_value is the text when the segment can stand in as a bare
    # name; splittable?/splat? are its field-splitting roles.
    class WordSegment[unchecked out V < Object]
      extend T::Sig
      extend T::Generic

      # The kind-specific payload domain: literal/substitution source text or a
      # parsed ParamRef (Sorbet bounds Value with it; RBS keeps V < Object).
      Payload: untyped

      Value: untyped

      def self.[]: (untyped arg) -> untyped

      @value: V

      @quoted: bool

      attr_reader value: V

      attr_reader quoted: bool

      def initialize: (V value, bool quoted) -> void

      # Each concrete segment expands itself to a string; the base is abstract
      # (raises), so every value flowing through the pipeline has #expand.
      def expand: (Executor executor) -> String

      def literal_value: () -> String?

      # This segment as dash's canonical job text prints it.
      def canon: () -> String

      def splittable?: () -> bool

      def splat?: () -> bool

      def append_field_parts: (Executor executor, Array[[String, bool, bool, bool]] parts) -> void

      # A copy with a rewritten value (e.g. after tilde expansion).
      def with_value: (V new_value) -> WordSegment[V]

      def ==: (Object? other) -> bool

      alias eql? ==

      def hash: () -> Integer

      def equality_value: () -> V
    end

    # Literal text. It expands to itself, can act as a bare name when unquoted,
    # and is never field-split.
    class LiteralSegment < WordSegment[String]
      extend T::Sig
      extend T::Generic

      Value: untyped

      # dash escapes special characters inside a quoted run's quotes.
      CANON_ESCAPES: Regexp

      attr_reader value: String

      def initialize: (String value, bool quoted) -> void

      def literal_value: () -> String?

      # A rewritten literal stays literal (the tilde rewriter relies on it).
      def with_value: (String new_value) -> self
    end

    # A segment substituted at expansion time (param / command / arithmetic): its
    # unquoted result undergoes field splitting.
    class DynamicSegment[unchecked out V < Object] < WordSegment[V]
      extend T::Sig
      extend T::Generic

      Value: untyped

      def splittable?: () -> bool
    end

    # $name / ${...}: value is the ParamRef.
    class ParamSegment < DynamicSegment[ParamRef]
      extend T::Sig
      extend T::Generic

      Value: untyped

      attr_reader value: ParamRef

      def initialize: (ParamRef value, bool quoted) -> void

      # $@ (always) and unquoted $* expand to one field per positional parameter.
      def splat?: () -> bool

      def append_field_parts: (Executor executor, Array[[String, bool, bool, bool]] parts) -> void
    end

    # $(...) / `...`: value is the command-substitution source.
    class CommandSegment < DynamicSegment[String]
      extend T::Sig
      extend T::Generic

      Value: untyped

      attr_reader value: String

      def initialize: (String value, bool quoted) -> void
    end

    # $((...)): value is the arithmetic source.
    class ArithSegment < DynamicSegment[String]
      extend T::Sig
      extend T::Generic

      Value: untyped

      attr_reader value: String

      def initialize: (String value, bool quoted) -> void
    end
    # The concrete segment kinds: a word's segment list holds only these four
    # (literal text, a ParamRef, or substitution/arithmetic source); the raising
    # bases share behavior but never sit in a list, so consumers take this union.
    type any_word_segment = LiteralSegment | ParamSegment | CommandSegment | ArithSegment

    AnySegment: untyped
  end
end
