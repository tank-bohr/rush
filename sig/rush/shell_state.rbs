module Rush
  # Original shell and parent process ids used for $$ and PPID.
  class ShellProcessIds < ::Data
    extend T::Sig

    attr_reader shell: Integer
    attr_reader parent: Integer

    def self.new: (Integer shell, Integer parent) -> ShellProcessIds

    def self.for: (SystemCalls system) -> ShellProcessIds
  end

  # The mutable shell state threaded through execution: shell variables,
  # the last command's status ($?, the one field with behaviour here), the shell
  # name ($0), and the session sub-objects it bundles for the rest of the
  # interpreter to drive directly — LoopNesting, Options, Positional, the
  # function/alias/trap tables and the command-location cache.
  class ShellState
    extend T::Sig

    @name: String
    @pids: ShellProcessIds
    @variables: ShellVariables
    @traps: TrapTable
    @last_status: Status
    @last_background_pid: Integer?
    @loops: LoopNesting
    @options: Options
    @positional: Positional
    @getopts: GetoptsState
    @functions: FunctionTable
    @aliases: AliasTable
    @command_hash: Hash[String, String]

    attr_reader functions: FunctionTable
    attr_reader traps: TrapTable
    attr_reader aliases: AliasTable
    attr_reader command_hash: Hash[String, String]
    attr_reader name: String
    # $$ and PPID stay the original ids in forked children, like POSIX shells.
    attr_reader pids: ShellProcessIds
    attr_reader variables: ShellVariables
    attr_reader loops: LoopNesting
    attr_reader options: Options
    attr_reader last_status: Status
    attr_reader last_background_pid: Integer?
    attr_reader positional: Positional
    attr_reader getopts: GetoptsState

    def initialize: (?environment: Environment, ?name: String, ?positional: Array[String], ?pids: ShellProcessIds) -> void

    # A stateless view over this state, built on demand like Executor#job_control.
    def parameters: () -> ShellParameters

    def with_function_frame: [T] (Array[String] args) { () -> T } -> T

    def with_loop: [T] () { () -> T } -> T

    def preserve_status: [T] () { () -> T } -> T

    # The last command's exit status ($?), recorded after each command runs;
    # returns the status it recorded (Executor#run passes it straight through).
    # Flip a shell option, keeping the side effects options carry in sync
    # (allexport mirrors onto the variable table); shared by the set builtin
    # and invocation flags.
    def set_option: (Symbol option, bool enabled) -> void

    def record_status: (Status status) -> Status

    def record_background_pid: (Integer pid) -> Integer

    def record_lineno: (Integer line) -> void

    private

    # The variables a POSIX shell is born with: PPID (2.5.3) and getopts'
    # OPTIND, initialized to 1 at shell startup.
    def seed_variables: () -> void
  end
end
