module Rush
  # A file descriptor closed by `n>&-` / `n<&-`. Any read or write raises a "bad
  # file descriptor" error so the command fails (status 1, as dash does);
  # IoTable#to_spawn_options maps it to :close so a spawned child gets the fd
  # closed too; close/flush are no-ops (it owns nothing).
  class ClosedStream
    extend T::Sig

    def write: (*untyped objects) -> bot

    def print: (*untyped objects) -> bot

    def puts: (*untyped objects) -> bot

    def <<: (untyped object) -> bot

    def printf: (*untyped objects) -> bot

    def gets: (?String? sep, ?Integer limit) -> bot

    def read: (?Integer? length, ?String outbuf) -> bot

    def readline: (*untyped args) -> bot

    def each_line: (*untyped args) -> bot

    def readpartial: (*untyped args) -> bot

    def close: () -> nil

    def flush: () -> self
  end
end
