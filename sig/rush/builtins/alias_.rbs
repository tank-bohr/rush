module Rush
  module Builtins
    # `alias [name[=value]...]` defines or prints aliases. With no operands it
    # lists every alias as a single-quoted `name=value` on stdout. An operand
    # containing `=` past its first character defines (the name is everything
    # before that `=`); a bare name prints that alias, or reports `alias: NAME not
    # found` on stderr and yields status 1 while still processing the rest.
    class Alias < Base
      extend T::Sig

      def call: () -> Status

      private

      def handle: (String operand) -> Status

      def define: (String name, String value) -> Status

      def query: (String name) -> Status

      def list: () -> Status

      def show: (String name, String value) -> Status

      def single_quote: (String text) -> ::String

      def keep: (Status status, Status result) -> Status

      def aliases: () -> AliasTable
    end
  end
end
