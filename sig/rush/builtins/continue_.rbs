module Rush
  module Builtins
    # `continue [n]` — resume the n-th enclosing loop's next iteration
    # (default 1); the shared POSIX 2.9.5 semantics live in LoopJump.
    class Continue < LoopJump
      extend T::Sig

      private

      def signal: () -> singleton(LoopControl)
    end
  end
end
