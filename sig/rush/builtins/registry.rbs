module Rush
  module Builtins
    # O(1) name -> builtin class lookup, populated by Builtins.default_registry.
    class Registry
      extend T::Sig

      @builtins: ::Hash[String?, untyped]

      def initialize: () -> void

      def register: (String name, untyped klass) -> untyped

      def fetch: (String? name) -> untyped

      def key?: (String? name) -> bool
    end
  end
end
