module Rush
  module Builtins
    # Reads one logical line for the `read` builtin from the given stream.
    # Without -r a backslash escapes the next character (annotating it as
    # protected from field splitting) and a trailing unescaped backslash joins
    # the next physical line. `call` returns the annotated characters plus
    # whether the line was complete — terminated by a newline before end of
    # file, dash's read exit-status rule.
    class ReadInput
      extend T::Sig

      class LineReader
        extend T::Sig

        POLL_INTERVAL: Float

        @stream: _IoStream

        @pending: ^() -> bool

        def initialize: (_IoStream stream, ^() -> bool pending) -> void

        def gets: () -> String?

        private

        def wait_for_line: (IO stream) -> String?

        def read_step: (IO stream, String line) -> void

        def append_char: (String line, String char) -> void

        def next_char: (IO stream) -> untyped

        def read_char: (IO stream) -> untyped
      end

      # A line whose backslash-pairs all match, leaving one lone trailing
      # backslash: a line-continuation request.
      CONTINUED: Regexp

      # One output character: an optional escaping backslash and the character.
      PAIR: Regexp

      @reader: LineReader

      @raw: bool

      @chars: Array[[ String, bool ]]

      @complete: bool

      def initialize: (_IoStream stdin, bool raw, ?pending: ^() -> bool) -> void

      def call: () -> [ Array[[ String, bool ]], bool ]?

      private

      def partial_result: (String partial) -> [ Array[[ String, bool ]], bool ]?

      def gather: () -> void

      # Appends the line's annotated characters; true means a continuation is
      # pending and the next physical line belongs to this logical one.
      def decode: (String text) -> bool

      def verbatim: (String text) -> void

      def cook: (String text) -> bool
    end
  end
end
