module Rush
  module Builtins
    # `unset [-fv] name ...` — remove each name. The default (and -v) unsets a
    # shell variable; -f unsets a function. Unsetting an absent name succeeds.
    class Unset < Base
      extend T::Sig

      def call: () -> Status

      private

      def names: () -> Array[String]

      def function?: () -> bool

      def remove: (String name) -> void

      def state: () -> ShellState
    end
  end
end
