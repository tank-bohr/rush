module Rush
  module Builtins
    # Renders a printf template against its arguments: literal text (with
    # backslash escapes), %% and the %[flags][width][.prec]conv conversions,
    # cycling the template while arguments remain. Flags/width/precision defer to
    # Ruby's format; numeric conversions coerce their argument (a present
    # non-number is reported via the ok flag and treated as 0, a missing one as
    # 0 silently). %b and octal escapes arrive in a later slice. Returns [text, ok].
    class PrintfFormatter
      extend T::Sig

      @args: Array[String]

      @cursor: Integer

      @argument_valid: bool

      @errors: Integer

      NUMERIC: ::Array["d" | "i" | "o" | "u" | "x" | "X"]

      SIGNED: ::Array["d" | "i"]

      INTEGER_PREFIX: Regexp

      SIGNED_MIN: Integer

      SIGNED_MAX: Integer

      UNSIGNED_MODULUS: Integer

      UNSIGNED_MAX: Integer

      # Scans and walks one pass of a printf template: literal runs and resolved
      # backslash escapes pass straight through, while each %conversion is handed
      # back to the formatter to render against the next argument (double
      # dispatch), so the scanning lives here and the formatting stays there.
      class Template < StringScanner
        extend T::Sig

        ESCAPES: ::Hash[String, String]

        ESCAPE_TABLE: EscapeTable

        SPEC: ::Regexp

        def initialize: (String template) -> void

        def emit: (PrintfFormatter formatter) -> String

        private

        def piece: (PrintfFormatter formatter, String char) -> String

        def conversion: (PrintfFormatter formatter) -> String

        def escape: () -> String
      end

      attr_reader errors: Integer

      def initialize: (Array[String] args) -> void

      def render: (String template) -> [ String, bool ]

      # Render one %conversion (called back from Template): %% is a literal %, a
      # numeric/char/string conversion consumes and formats the next argument.
      def convert: (String flags, String conv) -> String

      private

      def numeric: (String flags, String conv, String arg) -> String

      def to_int: (String arg) -> Integer

      def quoted_character: (String arg) -> Integer

      def parse_integer: (String source) -> Integer

      def signed_value: (Integer value) -> Integer

      def unsigned_value: (Integer value) -> Integer

      def clamp: (Integer value, Integer minimum, Integer maximum) -> Integer

      def argument_valid?: () -> bool

      def invalid: (?Integer value) -> Integer

      def take: () -> String

      def first_char: (String arg) -> String?
    end
  end
end
