module Rush
  module Builtins
    # `command name [arg ...]` runs name as a command, skipping shell functions
    # (so a function can call the builtin it shadows). `command -v name` prints
    # how name resolves — the name itself for a keyword/function/builtin, or the
    # PATH for an external — and exits 127 when it is unknown.
    class Command < Base
      extend T::Sig

      def call: () -> Status

      private

      def verify: (String? name) -> Status

      def verbose: (String? name) -> Status

      def run: (Array[String] args) -> Status

      def build_command: (Array[String] args) -> (Base | External)

      def build_named_command: (Array[String] args) -> (Base | External)

      def build_named_command_from_builtin: (Array[String] args, _BuiltinClass? builtin) -> (Base | External)

      def exported_env: () -> ::Hash[String, String]
    end
  end
end
