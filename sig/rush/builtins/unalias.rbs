module Rush
  module Builtins
    # `unalias name...` removes each named alias; `unalias -a` removes them all.
    # A name with no alias is reported as `unalias: NAME not found` on stderr with
    # status 1, but the remaining names are still processed.
    class Unalias < Base
      extend T::Sig

      def call: () -> Status

      private

      def remove_all: () -> Status

      def remove: (String name) -> Status

      def keep: (Status status, Status result) -> Status

      def aliases: () -> AliasTable
    end
  end
end
