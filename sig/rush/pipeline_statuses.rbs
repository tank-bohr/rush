module Rush
  # Chooses the observable status for a settled multi-stage pipeline,
  # carrying any stage's stop signal on the verdict (rush-mv8.4).
  class PipelineStatuses
    extend T::Sig

    @entries: Array[Status]

    def initialize: (Array[Status] entries) -> void

    def verdict: () -> Status

    def pipefail_verdict: () -> Status

    def last_stage: () -> Status

    def pipefail: () -> Status

    private

    def job_stopsig: () -> Integer?
  end
end
