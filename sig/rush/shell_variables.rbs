module Rush
  # Semantic facade for shell variables: ordinary get/assign/export/readonly
  # operations plus dynamic local scopes and logical PWD tracking delegated to
  # Scope. Environment and Scope remain storage details behind this API.
  class ShellVariables
    extend T::Sig
    extend Forwardable

    @environment: Environment

    @scope: Scope

    @assignments: Assignments

    @allexport: bool

    def pwd: () -> String?

    def initialize: (Environment environment) -> void

    def get: (String name) -> String?

    def allexport=: (bool enabled) -> void

    def assign: (String name, String value) -> String

    def export: (String name) -> void

    def readonly: (String name) -> void

    def unset: (String name) -> void

    def update_lineno: (Integer line) -> String?

    def exported: () -> Hash[String, String]

    def move_to: (String pwd) -> void

    def seed_pwd: (String path) -> void

    def current_pwd: () -> String

    def begin_scope: () -> void

    def end_scope: () -> void

    def in_function?: () -> bool

    def declare_local: (String name) -> void

    def export_operand: (String text) -> void

    def readonly_operand: (String text) -> void

    def declare_local_operand: (String text) -> void
  end
end
