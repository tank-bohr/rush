module Rush
  module Expansion
    # Builds scalar and operator-word parts without discarding quote provenance.
    class ParameterParts
      extend T::Sig

      @executor: Executor
      @quoted: bool

      def initialize: (Executor executor, bool quoted) -> void
      def scalar: (String text) -> Array[[String, bool, bool, bool]]
      def operator: (String text) -> Array[[String, bool, bool, bool]]
      def collapse: (Array[[String, bool, bool, bool]] parts) -> String
      def pattern: (String text) -> String

      private

      def preserve_empty_at: (Array[[String, bool, bool, bool]] expanded, AST::Word operator_word) -> Array[[String, bool, bool, bool]]
      def normalized: (Array[[String, bool, bool, bool]] expanded) -> Array[[String, bool, bool, bool]]
      def word: (String text) -> AST::Word
      def tilde_mode: () -> Symbol
    end

    # Expands one ParamRef to quote-aware field parts, then applies the
    # operator form (if any). The operator word is itself expanded (so
    # ${x:-$y} works) by re-scanning it into a Word and running it back through
    # the expansion pipeline. `quoted` picks the word's re-scan rules: a ${...}
    # inside double quotes or a here-doc keeps single quotes ordinary and
    # skips tilde expansion, as dash does.
    class ParameterExpander
      extend T::Sig

      @executor: Executor

      @ref: AST::ParamRef

      @quoted: bool

      @parts: ParameterParts

      # Operators handled here rather than by the FORMS lambdas: the ${#p} length
      # and the # ## % %% pattern-removal forms.
      PATTERN_REMOVAL: Array[String]

      def initialize: (Executor executor, AST::ParamRef ref, quoted: bool) -> void

      def expand: () -> String

      def expand_parts: () -> Array[[String, bool, bool, bool]]

      # A bare $x / ${x}: under `set -u` an unset ordinary name or positional is
      # an error (special parameters like $@ are exempt).
      def plain: () -> String

      def value: () -> String?

      def value_text: () -> String

      def unset_or_null?: () -> bool

      def arg: () -> String

      def arg_parts: () -> Array[[String, bool, bool, bool]]

      def value_parts: () -> Array[[String, bool, bool, bool]]

      def empty_parts: () -> Array[[String, bool, bool, bool]]

      def assign_parts: () -> Array[[String, bool, bool, bool]]

      def raise_unset: () -> bot

      private

      def length: () -> String

      def strip: (String op) -> String

      def pattern_arg: () -> String

      def unbound?: () -> bool

      def colon?: () -> bool

      def message: () -> String

      def argument: () -> String
    end
  end
end
