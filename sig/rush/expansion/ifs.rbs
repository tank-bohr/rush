module Rush
  module Expansion
    # The IFS value, parsed once into its whitespace and non-whitespace delimiter
    # sets for POSIX field splitting. Unset IFS (nil) defaults to the standard
    # <space><tab><newline>; a null IFS (the empty string) leaves both sets empty,
    # so no character delimits.
    class Ifs
      extend T::Sig

      @ifs: String?

      @chars: Array[String]

      @whitespace: Array[String]

      @others: Array[String]

      WHITESPACE: String

      DEFAULT_CHARS: Array[String]

      NO_CHARS: Array[String]

      def initialize: (String? ifs) -> void

      def null?: () -> bool

      attr_reader whitespace: Array[String]

      attr_reader others: Array[String]

      def preserve_empty_splat?: () -> bool

      def whitespace?: (String char) -> bool

      def other?: (String char) -> bool

      private

      def delimiter_sets: () -> [Array[String], Array[String]]
    end
  end
end
