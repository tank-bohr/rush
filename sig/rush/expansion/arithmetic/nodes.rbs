module Rush
  module Expansion
    module Arithmetic
      # The arithmetic AST. Every node evaluates to an Integer against the
      # Evaluator (ctx); inter-node members are themselves nodes (the AST holds
      # AST), captured by the `node` union.
      type node = Num | Var | Unary | Binary | And | Or | Cond | Assign

      # The four unary operator tokens as a string-literal union. The parser
      # narrows the scanned token to this via the typed UNARY table, so the type
      # rides the value into Unary#op and Number.unary. RBS can spell this set;
      # Sorbet (no string-literal types) types the same op as String — a drift.
      type unary_op = "+" | "-" | "!" | "~"

      # Sorbet runtime type alias used only by inline sigs in the implementation.
      Node: untyped

      # A literal integer.
      class Num
        extend T::Sig

        attr_reader value: Integer
        def initialize: (Integer value) -> void
        def result: (Evaluator ctx) -> Integer
      end

      # A variable reference; resolves its name through the evaluator.
      class Var
        extend T::Sig

        attr_reader name: String
        def initialize: (String name) -> void
        def result: (Evaluator ctx) -> Integer
      end

      # A unary operation (+ - ! ~) on one operand.
      class Unary
        extend T::Sig

        attr_reader op: unary_op
        attr_reader operand: node
        def initialize: (unary_op op, node operand) -> void
        def result: (Evaluator ctx) -> Integer
      end

      # A binary arithmetic / bitwise / comparison operation on two operands.
      class Binary
        extend T::Sig

        attr_reader op: String
        attr_reader left: node
        attr_reader right: node
        def initialize: (String op, node left, node right) -> void
        def result: (Evaluator ctx) -> Integer
      end

      class And
        extend T::Sig

        attr_reader left: node
        attr_reader right: node
        def initialize: (node left, node right) -> void
        def result: (Evaluator ctx) -> Integer
      end

      class Or
        extend T::Sig

        attr_reader left: node
        attr_reader right: node
        def initialize: (node left, node right) -> void
        def result: (Evaluator ctx) -> Integer
      end

      class Cond
        extend T::Sig

        attr_reader test: node
        attr_reader truthy: node
        attr_reader falsy: node
        def initialize: (node test, node truthy, node falsy) -> void
        def result: (Evaluator ctx) -> Integer
      end

      class Assign
        extend T::Sig

        attr_reader name: String
        attr_reader op: String
        attr_reader rhs: node
        def initialize: (String name, String op, node rhs) -> void
        def result: (Evaluator ctx) -> Integer
      end
    end
  end
end
