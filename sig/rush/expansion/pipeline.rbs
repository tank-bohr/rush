module Rush
  module Expansion
    # Orchestrates the ordered POSIX word expansion. Each segment expands itself
    # to one or more parts ([text, splittable, break_before, quoted]); unquoted results
    # undergo IFS field splitting and then pathname expansion. The one multi-field
    # case is "$@"/$@, which yields one part per positional parameter with a
    # forced field break between them ($* always joins to a scalar). Field
    # splitting carries quote provenance into the pathname-expansion boundary.
    interface _TildeExpansion
      def expand: () -> Array[AST::any_word_segment]
    end

    interface _TildeExpanderClass
      def new: (Executor executor, Array[AST::any_word_segment] segments) -> _TildeExpansion
    end

    class Pipeline
      extend T::Sig

      @executor: Executor

      @glob_expander: GlobExpander

      # Tilde expansion strategy per mode (its value is a word's segment list).
      TILDE_EXPANDERS: Hash[Symbol, _TildeExpanderClass]

      def initialize: (Executor executor) -> void

      # Argv expansion: expand each word to fields (splitting unquoted on IFS),
      # then expand each field's pathname patterns.
      def expand: (Array[AST::Word] words) -> Array[String]

      # Assignment RHS / redirection target / operator word: one field, no split.
      # The target may be an AST::Word or a HereDoc (both expose #segments).
      # Tilde expands at the leading position by default; assignment context also
      # expands after colons, and arithmetic opts out (~ is bitwise not there).
      def expand_value: (AST::Word | HereDoc word, ?tilde: Symbol) -> String

      def expand_parts: (AST::Word | HereDoc word, ?tilde: Symbol) -> Array[[String, bool, bool, bool]]

      def collapse: (Array[[String, bool, bool, bool]] expanded) -> String

      # A case/removal pattern keeps quoted metacharacters backslash-shielded.
      def expand_pattern: (AST::Word word, ?tilde: Symbol) -> String

      private

      def expanded_pattern: (AST::any_word_segment segment) -> String

      def append_word: (AST::Word word, Array[String] expanded) -> void

      def tilde_expand: (Array[AST::any_word_segment] segments, Symbol mode) -> Array[AST::any_word_segment]

      def append_field_parts: (AST::any_word_segment segment, Array[[String, bool, bool, bool]] expanded) -> void

      # Glob metacharacters in quoted text are escaped so they match literally;
      # unquoted text keeps them active.
      def escape_if_quoted: (AST::any_word_segment segment, String text) -> String

      def escape: (String text) -> String

      def append_splat_parts: (AST::any_word_segment segment, Array[[String, bool, bool, bool]] expanded) -> void

      def field_separator: () -> String

      def ifs: () -> String?
    end
  end
end
