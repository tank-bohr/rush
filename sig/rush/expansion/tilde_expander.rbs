module Rush
  module Expansion
    # Tilde expansion (step 1): a leading unquoted `~` or `~name` in a word's
    # first literal segment becomes $HOME or the named user's home directory. It
    # is left untouched when there is no such user, or when HOME is unset for a
    # bare `~`. This base handles the leading form; AssignmentTilde extends it to
    # also expand after each unquoted colon, and NoTilde disables it entirely.
    class TildeExpander
      extend T::Sig

      @executor: Executor

      @segments: Array[AST::WordSegment[untyped]]

      def initialize: (Executor executor, Array[AST::WordSegment[untyped]] segments) -> void

      def expand: () -> Array[AST::WordSegment[untyped]]

      private

      def replace_head: (AST::WordSegment[untyped] head, String text) -> Array[AST::WordSegment[untyped]]

      def rewrite: (String text) -> String

      def prefix: (String text) -> String

      def split: (String body) -> [ String, String ]

      def resolve: (String name) -> String?
    end

    # Assignment context (PATH=~/bin:~root/x): the leading tilde plus one after
    # each unquoted colon, so every colon-separated piece gets the ~ treatment.
    class AssignmentTilde < TildeExpander
      extend T::Sig

      private

      def rewrite: (String text) -> String

      def expandable?: (String text) -> bool
    end

    # Tilde expansion disabled (e.g. arithmetic operands): segments pass through.
    class NoTilde
      extend T::Sig

      @segments: Array[AST::WordSegment[untyped]]

      def initialize: (Executor _executor, Array[AST::WordSegment[untyped]] segments) -> void

      def expand: () -> Array[AST::WordSegment[untyped]]
    end
  end
end
