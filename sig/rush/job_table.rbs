module Rush
  # The shell's asynchronous jobs, and the single owner of child reaping (the
  # design risk epic rush-mv8 recorded): every synchronous wait routes through
  # #await, so no two waits can steal each other's statuses. While no
  # background job is running an await targets its pid directly; once an
  # asynchronous list has launched, it reaps whichever child exits next and
  # files foreign statuses — a background job's on its entry (where the wait
  # builtin finds it), a sibling foreground child's in a stash its own await
  # consults first. A reaped job's status stays remembered until the jobs
  # builtin displays it (dash frees reported entries); forked child
  # environments keep the entries only as unwaitable display copies
  # (POSIX 2.12 — see #enter_subshell).
  class JobTable
    extend T::Sig

    # One asynchronous job: its [n] number, pid, and — once reaped — the raw
    # Process::Status: the wait builtin derives $? from it, and the jobs
    # builtin renders Done(n) or a signal description.
    class Job
      extend T::Sig
      extend Forwardable

      # The creation-time facts: number, member pids, rendered text.
      class Identity
        extend T::Sig

        @number: Integer

        @members: Array[Integer]

        @text: String?

        attr_reader number: Integer

        attr_reader members: Array[Integer]

        attr_reader text: String?

        def initialize: (Integer number, Array[Integer] members, String? text) -> void
      end

      @identity: Identity

      @result: Status?

      @changed: bool

      @inherited: bool

      attr_reader changed: bool

      def initialize: (Integer number, Integer pid, ?members: Array[Integer], ?text: String?) -> void

      def number: () -> Integer

      def members: () -> Array[Integer]

      # The rendered command line ('' outside job control).
      def text: () -> String

      # Created under monitor mode — the kept text is the stamp (mv8.5/6).
      def controlled?: () -> bool

      # A fork demotes the entry to a POSIX 2.12 display copy: listable,
      # but refused by wait and %id resolution (rush-r6i).
      def inherit: () -> void

      def inherited?: () -> bool

      def stopsig: () -> Integer?

      # A stop parks the job; anything else settles it for good.
      def finish: (Process::Status raw) -> Status

      def stop: (Integer stopsig) -> void

      # fg/bg's SIGCONT: a stopped job runs again.
      def resume: () -> void

      # Resume + SIGCONT to the group; ESRCH (already gone) settles.
      def continue: (SystemCalls system) -> void

      # A state change was displayed; nothing further to announce.
      def reported: () -> void

      # Print this job's change and settle the report (dash showjob + free).
      def report: (JobTable table, _IoStream out) -> void

      # Reap once: the first harvest fills raw from the supplied wait;
      # repeats answer from memory (dash never frees an entry on wait). A
      # fork-inherited display copy answers nil — never reapable here.
      def harvest: () { () -> Process::Status } -> Status?

      def pid: () -> Integer

      def running?: () -> bool

      def stopped?: () -> bool

      def finished?: () -> bool

      def status: () -> Status
    end

    @system: SystemCalls

    @jobs: Hash[Integer, Job]

    @stash: Hash[Integer, Process::Status]

    @control: Control

    def initialize: (SystemCalls system) -> void

    # The durable job-control environment (root-shell bit, acquired
    # terminal): lives and dies with the table.
    attr_reader control: Control

    # A background launch: the pid becomes job [n] — the lowest free number,
    # as dash numbers slots. Fake fork ports return no child pid (mapped to
    # 0); a real parent always records a positive one.
    def record: (Integer pid, ?text: String?) -> void

    # A ^Z-stopped foreground job becomes a Stopped table entry.
    def adopt_stopped: (Array[Integer] pids, Integer stopsig, ?String? text) -> void

    # Newest first: the jobs builtin's display order, and what makes the
    # first entry the current job (+) and the second the previous one (-).
    def ordered: () -> Array[Job]

    def current: () -> Job?

    def previous: () -> Job?

    def numbered: (Integer number) -> Job?

    # Blocking wait for a foreground child's status. ECHILD is a defensive
    # guard: entries never outlive their environment (forked children clear
    # the table), so a wait on a vanished child answers success rather than
    # crashing.
    def await: (Integer pid) -> Status

    # The wait builtin, one pid: a remembered status, a blocking wait on a
    # live job, or nil when the pid is not a waitable job here — unknown,
    # or a fork-inherited display copy (POSIX: 127).
    def wait_for: (Integer pid) -> Status?

    # A forked child environment is a duplicate of the shell environment
    # (POSIX 2.12), async pids included: entries stay for display (jobs,
    # jobs -p, the parent's `wait $(jobs -p)`) but demote to inherited
    # copies — wait by pid reports 127 and a %id reports No such job, as
    # dash does in a real (non-tail-optimized) forked child.
    def enter_subshell: () -> void

    # The jobs builtin, after displaying a finished entry: dash frees
    # reported jobs, so a later wait or %id no longer knows them.
    def forget: (Job job) -> void

    # Opportunistic non-blocking reap, so the jobs builtin sees a child that
    # finished since the last synchronous wait.
    def poll: () -> void

    # The stopped-jobs exit guard (the Control's dash-job_warning window).
    # fg's wait over every member of a resumed job (rush-mv8.5).
    def settle_members: (Job job) -> Status

    # dash's cmdloop showjobs(SHOW_CHANGED), before each PS1 (the Repl).
    def announce_changed: (_IoStream out) -> void

    private

    def settle: (Integer pid) -> Process::Status

    def free_number: () -> Integer

    # A relayed stop (StopRelay) re-raises onto this process and, after
    # SIGCONT, re-waits the same target.
    def reap_raw: (Integer target) -> Process::Status

    # waitpid(-1) only when a background job could exit meanwhile; the direct
    # form cannot reap a foreign child, keeping the plain foreground path
    # byte-identical to the pre-table behaviour.
    def reap_one: (Integer target) -> [ Integer, Process::Status ]

    def store: (Integer pid, Process::Status status) -> void
  end
end
